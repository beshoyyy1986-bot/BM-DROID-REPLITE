# انسخ هذا الملف إلى .env واملأ القيم

# دخول لوحة الأدمن
ADMIN_USER=admin
ADMIN_PASS=change-me-strong-password
SESSION_SECRET=

# Supabase — من Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_xxx
SUPABASE_ANON_KEY=anon_xxx

# رابط حزمة الرن-تايم (QEMU + صورة أندرويد) — ابنِها مرة واحدة بـ runtime/make-runtime.ps1
# وارفعها على Supabase Storage أو أي استضافة، ثم ضع رابطها المباشر هنا
RUNTIME_URL=
RUNTIME_SHA256=

PORT=3000
